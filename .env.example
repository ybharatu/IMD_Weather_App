# Copy to .env and fill in your values
API_KEY=

# --- Daily weather email (Gmail via nodemailer) ---
# SMTP_USER: your full Gmail address
# SMTP_PASS: a Gmail App Password (NOT your normal password) —
#            https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Your own email for the daily Nanded forecast (optional — can subscribe via website)
EMAIL_TO=
EMAIL_CITY=Nanded
# Time to send daily, in IST, 24h format
EMAIL_TIME=07:00
EMAIL_ENABLED=true
