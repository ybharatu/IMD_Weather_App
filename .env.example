# Copy to .env and fill in your values
API_KEY=

# --- Daily weather email (Gmail via nodemailer) ---
# SMTP_USER: your full Gmail address
# SMTP_PASS: a Gmail App Password (NOT your normal password) —
#            https://myaccount.google.com/apppasswords
# NOTE: Render FREE tier blocks SMTP (ports 25/465/587). Use the Gmail API
# instead there (see GMAIL_* below); SMTP works locally.
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Your own email for the daily Nanded forecast (optional — can subscribe via website)
EMAIL_TO=
EMAIL_CITY=Nanded
# Time to send daily, in IST, 24h format
EMAIL_TIME=07:00
EMAIL_ENABLED=true

# --- Gmail API (for Render/any host that blocks SMTP) ---
# Get credentials: https://console.cloud.google.com (enable Gmail API,
# OAuth consent screen, create OAuth Client ID "Desktop app"), then run:
#   node scripts/getGmailToken.js <CLIENT_ID> <CLIENT_SECRET>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
